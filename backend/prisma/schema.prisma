// D2F Shipping — staff parcel foundation, warehouse operations and admin commerce.
// Existing permanent tracking identities and role boundaries are retained.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organizations: D2F and permitted partner orgs (future SaaS-ready)
model Organization {
  id              String           @id @default(uuid())
  name            String
  trackingPrefix  String           @unique
  trackingCounter BigInt           @default(1)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  users           User[]
  locations       Location[]
  customers       Customer[]
  parcels         Parcel[]
  containers      Container[]
  products        Product[]
  serviceOrders   ServiceOrder[]
  connectTrips    ConnectTrip[]
  connectRates    ConnectRate[]
  connectBookings ConnectBooking[]
  sellerProfiles  SellerProfile[]
}

// These identity reservations intentionally outlive deleted organizations/parcels.
// Database triggers make them append-only; they contain no customer details.
model TrackingPrefixReservation {
  prefix         String   @id
  organizationId String   @unique
  createdAt      DateTime @default(now())
}

model TrackingNumberReservation {
  trackingId       String   @id
  parcelId         String   @unique
  organizationId   String
  trackingSequence BigInt?
  createdAt        DateTime @default(now())

  @@unique([organizationId, trackingSequence])
}

// Locations: Omaha warehouse, Lomé facility, etc.
model Location {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  code             String // e.g. OMA-1, LOME-1
  city             String?
  country          String?
  timezone         String   @default("America/Chicago")
  address          String?
  connectReceiving Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization       Organization     @relation(fields: [organizationId], references: [id])
  users              User[]
  parcels            Parcel[]
  transfersFrom      ParcelTransfer[] @relation("transferFrom")
  transfersTo        ParcelTransfer[] @relation("transferTo")
  outboundContainers Container[]      @relation("containerOrigin")
  inboundContainers  Container[]      @relation("containerDestination")
  connectTrips       ConnectTrip[]
  connectBookings    ConnectBooking[]

  @@unique([organizationId, code])
}

// Users: staff, customers, drivers. Roles enforced by backend middleware.
// M1 focuses on STAFF; role enums ready for M2/M3 expansion.
enum Role {
  ADMIN
  STAFF
  CUSTOMER
  DRIVER
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  phone          String?
  role           Role     @default(CUSTOMER)
  authVersion    Int      @default(0)
  organizationId String?
  locationId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])

  parcelsCreated   Parcel[]         @relation("parcelsCreatedBy")
  parcelImages     ParcelImage[]
  customerProfile  Customer?
  events           TrackingEvent[]
  transfers        ParcelTransfer[] @relation("transferActor")
  socialIdentities SocialIdentity[]
  passwordResets   PasswordReset[]
  connectTrips     ConnectTrip[]
  sellerProfile    SellerProfile?
  notifications    Notification[]
}

// Marketplace / Buy For Me updates that reach a user inside the app (and, when
// push credentials are configured, as a real device notification).
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SocialIdentity {
  id       String @id @default(uuid())
  provider String
  subject  String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
}

model PasswordReset {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  authVersion Int
  attempts    Int      @default(0)
  expiresAt   DateTime

  @@index([expiresAt])
}

// The browser callback and the app's polling request may hit different replicas.
model SocialLoginFlow {
  id         String   @id @default(uuid())
  provider   String
  secretHash String
  stateHash  String   @unique
  nonce      String
  verifier   String
  status     String   @default("pending")
  userId     String?
  error      String?
  expiresAt  DateTime

  @@index([expiresAt])
}

// Customers: shipping/billing identity associated with parcels
model Customer {
  id             String   @id @default(uuid())
  userId         String?  @unique
  organizationId String?
  displayName    String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  createdAt      DateTime @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parcels       Parcel[]
  serviceOrders ServiceOrder[]
}

// Parcels: permanent UUID + public tracking ID
model Parcel {
  id                         String          @id @default(uuid()) // permanent internal UUID
  trackingId                 String          @unique // immutable, globally unique public tracking ID
  organizationId             String
  trackingSequence           BigInt?
  customerId                 String // shipper
  recipientName              String
  recipientPhone             String?
  recipientAddress           String?
  packageType                String // BOX, BARREL, TV, APPLIANCE, FURNITURE, PALLET, VEHICLE...
  weightKg                   Float
  origin                     String // commercial shipping origin, separate from the intake warehouse
  destination                String
  pickupAddress              String? // required for same-city road pickups
  method                     String          @default("SEA") // AIR | SEA | ROAD
  serviceType                String          @default("SEA") // AIR_CARGO | AIR_TRAVELLER | SEA | ROAD
  awbNumber                  String?
  airline                    String?
  flightNumber               String?
  volumetricWeightKg         Float?
  customsDocuments           String?
  connectBooking             ConnectBooking?
  notes                      String?
  status                     String          @default("RECEIVED")
  // Customer shipment requests: how goods reach D2F.
  // PICKUP = D2F collects from the customer's address (pickupScheduledAt).
  // DROP_OFF = the customer brings the goods to the D2F warehouse.
  deliveryMode               String          @default("DROP_OFF") // PICKUP | DROP_OFF
  pickupPreferredAt          DateTime?
  pickupDriverId             String?
  pickupTargetLocationId     String?
  pickupConfirmedAt          DateTime?
  pickupConfirmedById        String?
  pickupProofReference       String?
  warehouseReceivedAt        DateTime?
  warehouseReceivedById      String?
  deliveryDriverId           String?
  pickupScheduledAt          DateTime? // D2F-confirmed pickup appointment
  restrictionsAcknowledgedAt DateTime? // customer acknowledged the content/shipping rules when requesting
  createdById                String
  locationId                 String? // current physical facility; separate from origin/destination
  containerId                String?
  items                      ParcelItem[]
  images                     ParcelImage[]
  clientRequestId            String? // retry keys belong to the organization that issued them
  // Handover and delivery evidence. These are written once and retained with the parcel.
  releasedToName             String?
  releasedToIdNumber         String?
  releasedAt                 DateTime?
  deliveredToName            String?
  deliveredToIdNumber        String?
  deliveredAt                DateTime?
  deliveryProofType          String? // SIGNATURE | PHOTO | ID_CONFIRMATION
  deliveryProofReference     String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer      Customer         @relation(fields: [customerId], references: [id])
  createdBy     User             @relation("parcelsCreatedBy", fields: [createdById], references: [id])
  location      Location?        @relation(fields: [locationId], references: [id])
  events        TrackingEvent[]  @relation("parcelEvents")
  transfers     ParcelTransfer[]
  trackingIndex TrackingIndex?
  serviceOrders ServiceOrder[]
  container     Container?       @relation(fields: [containerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, trackingSequence])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId, createdAt])
}

// trackingIndex equivalent: unique public tracking ID lookup + QR payload
model TrackingIndex {
  trackingId String   @id
  parcelId   String   @unique
  createdAt  DateTime @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id])
}

// Goods the customer is sending, itemized under one shipment request.
// A shipment can hold many things (5–6 boxes, clothing, appliances...).
model ParcelItem {
  id                  String    @id @default(uuid())
  parcelId            String
  name                String // "Clothing box", "60-inch TV", "Spices"...
  details             String? // short free-form description for the intake team
  quantity            Int       @default(1)
  weightKg            Float? // optional per-item estimate
  position            Int       @default(0)
  type                String    @default("BOX") // BOX | SUITCASE | BARREL | TV | APPLIANCE | FURNITURE | PALLET | VEHICLE | DOCUMENTS | OTHER
  lengthCm            Float? // optional package dimensions, recorded together
  widthCm             Float?
  heightCm            Float?
  packageCode         String? // D2F…-P01-style sub-ID allocated when goods enter D2F custody
  warehouseReceivedAt DateTime?
  collectedAt         DateTime? // set for every observed package at a pickup collection
  notCollectedReason  String? // why a declared package was not on hand
  createdAt           DateTime  @default(now())

  parcel       Parcel        @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  parcelImages ParcelImage[]

  @@index([parcelId, position])
}

// Photos of the goods, attached by the customer. Stored as bytes so the
// shipped-evidence gallery survives hosting redeploys without object storage.
// An image attaches to the whole shipment or, via itemId, to one declared
// package; the association freezes once the shipment leaves intake editing.
model ParcelImage {
  id           String   @id @default(uuid())
  parcelId     String
  itemId       String? // optional: this photo documents one declared package
  fileName     String
  contentType  String // image/jpeg | image/png | image/webp
  sizeBytes    Int
  bytes        Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  parcel     Parcel      @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  item       ParcelItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([parcelId, createdAt])
}

// Timestamped, traceable event history
model TrackingEvent {
  id        String   @id @default(uuid())
  parcelId  String
  status    String
  note      String?
  originalNote String?
  internalNote String?
  templateId String?
  facilityId String?
  location  String?
  actorId   String?
  createdAt DateTime @default(now())

  parcel Parcel @relation("parcelEvents", fields: [parcelId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([parcelId, createdAt])
}

// Physical facility-to-facility movement after international arrival. A parcel
// must be received at the named destination before it can be released there.
model ParcelTransfer {
  id             String   @id @default(uuid())
  parcelId       String
  fromLocationId String?
  toLocationId   String
  actorId        String?
  note           String?
  createdAt      DateTime @default(now())

  parcel       Parcel    @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  fromLocation Location? @relation("transferFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location  @relation("transferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  actor        User?     @relation("transferActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([parcelId, createdAt])
}

// Audit log for material actions (M1: registration + status updates)
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  detail    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// M2: a parcel belongs to at most one container. Loading closes at departure.
model Container {
  id             String           @id @default(uuid())
  organizationId String
  code           String
  originId       String
  destinationId  String
  method         String           @default("SEA")
  status         String           @default("LOADING")
  sealNumber     String?
  notes          String?
  manifest       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  origin         Location         @relation("containerOrigin", fields: [originId], references: [id], onDelete: Restrict)
  destination    Location         @relation("containerDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  parcels        Parcel[]
  events         ContainerEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, createdAt])
}

model ContainerEvent {
  id          String    @id @default(uuid())
  containerId String
  action      String
  detail      String?
  actorName   String
  createdAt   DateTime  @default(now())
  container   Container @relation(fields: [containerId], references: [id], onDelete: Restrict)

  @@index([containerId, createdAt])
}

// D2F Marketplace sellers. One profile per account; customers apply in the
// app, administrators approve and agree the commission rate BEFORE the first
// sale. Commission is snapshotted on every order from the agreed profile rate.
model SellerProfile {
  id              String    @id @default(uuid())
  organizationId  String
  userId          String    @unique
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  displayName     String
  businessType    String    @default("INDIVIDUAL") // INDIVIDUAL | BUSINESS
  businessName    String?
  headline        String?
  bio             String?
  category        String
  phone           String
  email           String?
  country         String
  city            String?
  address         String?
  // Agreed before the first sale; basis points (1000 = 10.00%).
  commissionBps   Int       @default(1000)
  termsAcceptedAt DateTime?
  termsAccepted   Boolean   @default(false)
  verificationStatus String  @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Shop branding: profile photo + cover banner, stored like product photos.
  profilePicture  Bytes?
  profilePictureName String? @default("")
  banner          Bytes?
  bannerName      String? @default("")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]
  orders       ServiceOrder[]
  verification SellerVerification?
  earnings     SellerEarnings?
  payouts      SellerPayout[]

  @@index([organizationId, status, createdAt])
}

// Seller identity/business verification documents submitted during onboarding.
model SellerVerification {
  id             String   @id @default(uuid())
  sellerId       String   @unique
  seller         SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  idDocumentType String?   // passport | national_id | business_license
  idDocumentName String?
  idDocumentBytes Bytes?
  businessDocName String?
  businessDocBytes Bytes?
  selfieBytes    Bytes?
  status         String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Global D2F commission / fee configuration (configurable, not hardcoded).
model CommissionSettings {
  id             String   @id @default(uuid())
  // Platform commission on marketplace sales (basis points, 1000 = 10%).
  platformCommissionBps Int   @default(1000)
  // Default fulfillment fee (basis points of order amount) when D2F fulfils.
  defaultFulfillmentFeeBps Int @default(500)
  // Default delivery fee (basis points) for D2F delivery.
  defaultDeliveryFeeBps  Int   @default(300)
  updatedAt      DateTime  @updatedAt
  updatedById    String?
}

// Seller earnings accumulator (commission + fulfillment + delivery fees tracked separately).
model SellerEarnings {
  id              String   @id @default(uuid())
  sellerId        String   @unique
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // Gross merchandise value sold (before fees).
  grossMerchandiseMinor Int   @default(0)
  // Commission earned by D2F from this seller.
  commissionEarnedMinor   Int   @default(0)
  // Fulfillment fees earned by D2F.
  fulfillmentFeeEarnedMinor Int @default(0)
  // Delivery fees earned by D2F.
  deliveryFeeEarnedMinor    Int @default(0)
  // Net payable to seller.
  netPayableMinor           Int   @default(0)
  // Amount already paid out.
  paidOutMinor              Int   @default(0)
  updatedAt             DateTime  @updatedAt
}

// Payouts to sellers (admin-triggered).
model SellerPayout {
  id             String   @id @default(uuid())
  sellerId       String
  seller         SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amountMinor    Int
  currency       String   @default("USD")
  status         String   @default("PENDING") // PENDING | PAID | CANCELLED
  paidAt         DateTime?
  reference      String?  // bank transfer ref, etc.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Administrative records for the selected Marketplace and Buy For Me modules.
// D2F catalog products have no seller; third-party listings belong to an
// approved SellerProfile. Stock stays null/uncounted until the Fulfillment
// phase, but the columns exist so warehouse counts can land without a
// destructive migration.
model Product {
  id             String         @id @default(uuid())
  organizationId String
  title          String
  category       String
  description    String?
  priceMinor     Int
  currency       String         @default("USD")
  status         String         @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED | SUSPENDED
  isActive       Boolean        @default(false)
  sellerId       String?
  fulfillment    String         @default("D2F") // SELLER | D2F
  stockCount     Int? // null = stock not tracked yet (Fulfillment phase)
  locationCity   String?
  locationCountry String?
  featured       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seller         SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  orders         ServiceOrder[]
  images         ProductImage[]

  @@index([organizationId, createdAt])
  @@index([organizationId, isActive, category])
  @@index([organizationId, isActive, featured])
  @@index([sellerId])
}

// Product photos ride in the database as bytes (same policy as goods photos)
// so listings survive redeploys without external object storage.
model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  fileName    String
  contentType String
  sizeBytes   Int
  bytes       Bytes
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ServiceOrder {
  id             String       @id @default(uuid())
  organizationId String
  kind           String
  customerId     String
  productId      String?
  sellerId       String?
  parcelId       String?
  title          String
  sourceUrl      String?
  quantity       Int          @default(1)
  amountMinor    Int?
  currency       String       @default("USD")
  status         String       @default("REQUESTED")
  notes          String?
  source         String       @default("ADMIN") // ADMIN | APP
  // Commission snapshot taken from the agreed seller rate at order time.
  commissionBps  Int?
  commissionMinor Int?
  // Fulfillment fee charged by D2F (when D2F fulfils).
  fulfillmentFeeBps Int?
  fulfillmentFeeMinor Int?
  // Delivery fee charged by D2F (when D2F delivers).
  deliveryFeeBps Int?
  deliveryFeeMinor Int?
  // Net amount payable to seller after all fees.
  sellerNetMinor Int?
  // Delivery choice + recipient details captured at app checkout.
  deliveryPreference String?  // SELLER | D2F
  recipientName      String?
  recipientPhone     String?
  deliveryAddress    String?
  deliveryCity       String?
  deliveryCountry    String?
  // Buy For Me: buyer's target budget and the seller's carrier reference.
  budgetMinor    Int?
  trackingRef    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller         SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  parcel         Parcel?      @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  @@index([organizationId, kind, createdAt])
  @@index([organizationId, sellerId, createdAt])
}

// D2F Connect has its own commercial and custody workflow. Traveller access is
// projected by the API: never return customer identities, addresses or contacts.
model ConnectTrip {
  id                    String              @id @default(uuid())
  organizationId        String
  travellerId           String
  origin                String
  destination           String
  departureAt           DateTime
  flightNumber          String
  capacityKg            Float
  categories            String[]
  verificationReference String
  status                String              @default("PENDING_REVIEW")
  reviewNote            String?
  receivingLocationId   String?
  compensationMinor     Int                 @default(0)
  expensesMinor         Int                 @default(0)
  currency              String              @default("USD")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  traveller             User                @relation(fields: [travellerId], references: [id], onDelete: Restrict)
  receivingLocation     Location?           @relation(fields: [receivingLocationId], references: [id], onDelete: Restrict)
  requestedBookings     ConnectBooking[]    @relation("requestedTrip")
  assignments           ConnectAssignment[]

  @@index([organizationId, status, departureAt])
}

model ConnectRate {
  id             String       @id @default(uuid())
  organizationId String
  origin         String
  destination    String
  category       String
  unit           String // KG | ITEM | FLAT | MANUAL
  amountMinor    Int
  maxWeightKg    Float?
  currency       String       @default("USD")
  isActive       Boolean      @default(true)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, origin, destination, category])
}

model ConnectBooking {
  id                       String              @id @default(uuid())
  organizationId           String
  parcelId                 String              @unique
  category                 String
  quantity                 Int
  declaredValueMinor       Int
  preferredDate            DateTime
  requestedTripId          String?
  verifiedWeightKg         Float?
  contentsVerifiedAt       DateTime?
  contentsVerificationNote String?
  internationalFeeMinor    Int?
  domesticCostMinor        Int?
  currency                 String              @default("USD")
  paymentInstructions      String?
  pricingSnapshot          Json?
  quoteAcceptedAt          DateTime?
  handoverMode             String // DOMESTIC_SHIPPING | DROP_OFF | PICKUP
  senderCity               String
  senderAddress            String?
  deliveryPreference       String              @default("D2F_PICKUP")
  domesticCarrier          String?
  domesticTrackingNumber   String?
  domesticLabelUrl         String?
  domesticStatus           String              @default("NOT_REQUIRED")
  receivingLocationId      String?
  originReceivedAt         DateTime?
  handoverCodeHash         String?
  handoverCodeExpiresAt    DateTime?
  handoverAttempts         Int                 @default(0)
  collectedAt              DateTime?
  destinationReceivedAt    DateTime?
  deliveredAt              DateTime?
  deliveryEvidence         String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parcel                   Parcel              @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  requestedTrip            ConnectTrip?        @relation("requestedTrip", fields: [requestedTripId], references: [id], onDelete: Restrict)
  receivingLocation        Location?           @relation(fields: [receivingLocationId], references: [id], onDelete: Restrict)
  assignments              ConnectAssignment[]
  payment                  ConnectPayment?
  declarations             ConnectDeclaration[]
  paymentSubmissions       ConnectPaymentSubmission[]
  reviewedDeclarationId    String?
  complianceReviewedById   String?
  paymentInstructionsVersion Int @default(0)

  @@index([organizationId, createdAt])
}

model ConnectAssignment {
  id           String         @id @default(uuid())
  bookingId    String
  tripId       String
  status       String         @default("PROPOSED")
  responseNote String?
  createdAt    DateTime       @default(now())
  acceptedAt   DateTime?
  confirmedAt  DateTime?
  declarations ConnectTravellerDeclaration[]
  booking      ConnectBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  trip         ConnectTrip    @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tripId, status])
  @@index([bookingId, status])
}

model ConnectPayment {
  id             String         @id @default(uuid())
  organizationId String
  bookingId      String         @unique
  reference      String
  amountMinor    Int
  currency       String         @default("USD")
  recordedById   String
  createdAt      DateTime       @default(now())
  booking        ConnectBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
}


// Append-only customer acknowledgments. Contents changes create a new revision.
model ConnectDeclaration {
  id String @id @default(uuid())
  bookingId String
  customerId String
  userId String
  legalName String
  contents String
  contentsHash String
  termsVersion String
  acknowledgment String
  checks Json
  guidance Json
  audit Json
  createdAt DateTime @default(now())
  booking ConnectBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@index([bookingId, createdAt])
}

// Submission is evidence awaiting admin verification; it never confirms payment.
model ConnectPaymentSubmission {
  id String @id @default(uuid())
  bookingId String
  userId String
  method String
  transactionId String?
  instructionsVersion Int
  instructionsSnapshot String
  fileName String?
  contentType String?
  bytes Bytes?
  status String @default("PENDING")
  reviewNote String?
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  booking ConnectBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@index([bookingId, createdAt])
}

model OperationalNoteTemplate {
  id String @id @default(uuid())
  organizationId String
  status String
  serviceType String @default("ALL")
  message String
  customerMessage String
  isActive Boolean @default(true)
  position Int @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@index([organizationId, status, isActive])
}


model ConnectTravellerDeclaration {
  id String @id @default(uuid())
  assignmentId String
  userId String
  legalName String
  contentsHash String
  termsVersion String
  contents String
  checks Json
  acknowledgment String
  audit Json
  createdAt DateTime @default(now())
  assignment ConnectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  @@index([assignmentId, createdAt])
}

// Device-reported print audit. These records do not change physical custody.
model LabelPrintJob {
  id String @id @default(uuid())
  organizationId String
  parcelId String
  actorId String
  clientJobId String
  printerName String
  printerAddress String?
  labelHash String
  pages Int
  status String
  message String?
  source String
  reason String?
  deviceAt DateTime
  createdAt DateTime @default(now())
  @@unique([organizationId, actorId, clientJobId])
  @@index([organizationId, parcelId, createdAt])
}
