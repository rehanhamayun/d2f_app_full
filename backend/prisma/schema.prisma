// D2F Shipping — staff parcel foundation, warehouse operations and admin commerce.
// Existing permanent tracking identities and role boundaries are retained.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organizations: D2F and permitted partner orgs (future SaaS-ready)
model Organization {
  id                 String             @id @default(uuid())
  name               String
  trackingPrefix     String             @unique
  trackingCounter    BigInt             @default(1)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  users              User[]
  locations          Location[]
  customers          Customer[]
  parcels            Parcel[]
  containers         Container[]
  products           Product[]
  serviceOrders      ServiceOrder[]
  connectTrips       ConnectTrip[]
  connectRates       ConnectRate[]
  connectBookings    ConnectBooking[]
  sellerProfiles     SellerProfile[]
  buyForMeRequests   BuyForMeRequest[]
  shipForMeRequests  ShipForMeRequest[]
  warehouseAddresses WarehouseAddress[]
}

// These identity reservations intentionally outlive deleted organizations/parcels.
// Database triggers make them append-only; they contain no customer details.
model TrackingPrefixReservation {
  prefix         String   @id
  organizationId String   @unique
  createdAt      DateTime @default(now())
}

model TrackingNumberReservation {
  trackingId       String   @id
  parcelId         String   @unique
  organizationId   String
  trackingSequence BigInt?
  createdAt        DateTime @default(now())

  @@unique([organizationId, trackingSequence])
}

// Locations: Omaha warehouse, Lomé facility, etc.
model Location {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  code             String // e.g. OMA-1, LOME-1
  city             String?
  country          String?
  timezone         String   @default("America/Chicago")
  address          String?
  connectReceiving Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization       Organization     @relation(fields: [organizationId], references: [id])
  users              User[]
  parcels            Parcel[]
  transfersFrom      ParcelTransfer[] @relation("transferFrom")
  transfersTo        ParcelTransfer[] @relation("transferTo")
  outboundContainers Container[]      @relation("containerOrigin")
  inboundContainers  Container[]      @relation("containerDestination")
  connectTrips       ConnectTrip[]
  connectBookings    ConnectBooking[]

  @@unique([organizationId, code])
}

// Users: staff, customers, drivers. Roles enforced by backend middleware.
// M1 focuses on STAFF; role enums ready for M2/M3 expansion.
enum Role {
  ADMIN
  STAFF
  CUSTOMER
  DRIVER
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  phone          String?
  role           Role     @default(CUSTOMER)
  authVersion    Int      @default(0)
  organizationId String?
  locationId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])

  parcelsCreated   Parcel[]         @relation("parcelsCreatedBy")
  parcelImages     ParcelImage[]
  customerProfile  Customer?
  events           TrackingEvent[]
  transfers        ParcelTransfer[] @relation("transferActor")
  socialIdentities SocialIdentity[]
  passwordResets   PasswordReset[]
  connectTrips     ConnectTrip[]
  sellerProfile    SellerProfile?
  notifications    Notification[]
}

// Marketplace / Buy For Me updates that reach a user inside the app (and, when
// push credentials are configured, as a real device notification).
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SocialIdentity {
  id       String @id @default(uuid())
  provider String
  subject  String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
}

model PasswordReset {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  authVersion Int
  attempts    Int      @default(0)
  expiresAt   DateTime

  @@index([expiresAt])
}

// The browser callback and the app's polling request may hit different replicas.
model SocialLoginFlow {
  id         String   @id @default(uuid())
  provider   String
  secretHash String
  stateHash  String   @unique
  nonce      String
  verifier   String
  status     String   @default("pending")
  userId     String?
  error      String?
  expiresAt  DateTime

  @@index([expiresAt])
}

// Customers: shipping/billing identity associated with parcels
model Customer {
  id             String   @id @default(uuid())
  userId         String?  @unique
  organizationId String?
  displayName    String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  createdAt      DateTime @default(now())

  user                 User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization         Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parcels              Parcel[]
  serviceOrders        ServiceOrder[]
  buyForMeRequests     BuyForMeRequest[]
  shipForMeRequests    ShipForMeRequest[]
  payments             Payment[]
  returnRequests       ReturnRequest[]
  agreementAcceptances CustomerAgreementAcceptance[]
}

// Parcels: permanent UUID + public tracking ID
model Parcel {
  id                         String          @id @default(uuid()) // permanent internal UUID
  trackingId                 String          @unique // immutable, globally unique public tracking ID
  organizationId             String
  trackingSequence           BigInt?
  customerId                 String // shipper
  recipientName              String
  recipientPhone             String?
  recipientAddress           String?
  packageType                String // BOX, BARREL, TV, APPLIANCE, FURNITURE, PALLET, VEHICLE...
  weightKg                   Float
  origin                     String // commercial shipping origin, separate from the intake warehouse
  destination                String
  pickupAddress              String? // required for same-city road pickups
  method                     String          @default("SEA") // AIR | SEA | ROAD
  serviceType                String          @default("SEA") // AIR_CARGO | AIR_TRAVELLER | SEA | ROAD
  awbNumber                  String?
  airline                    String?
  flightNumber               String?
  volumetricWeightKg         Float?
  customsDocuments           String?
  connectBooking             ConnectBooking?
  notes                      String?
  status                     String          @default("RECEIVED")
  // Customer shipment requests: how goods reach D2F.
  // PICKUP = D2F collects from the customer's address (pickupScheduledAt).
  // DROP_OFF = the customer brings the goods to the D2F warehouse.
  deliveryMode               String          @default("DROP_OFF") // PICKUP | DROP_OFF
  pickupPreferredAt          DateTime?
  pickupDriverId             String?
  pickupTargetLocationId     String?
  pickupConfirmedAt          DateTime?
  pickupConfirmedById        String?
  pickupProofReference       String?
  warehouseReceivedAt        DateTime?
  warehouseReceivedById      String?
  deliveryDriverId           String?
  pickupScheduledAt          DateTime? // D2F-confirmed pickup appointment
  restrictionsAcknowledgedAt DateTime? // customer acknowledged the content/shipping rules when requesting
  createdById                String
  locationId                 String? // current physical facility; separate from origin/destination
  containerId                String?
  items                      ParcelItem[]
  images                     ParcelImage[]
  clientRequestId            String? // retry keys belong to the organization that issued them
  // Handover and delivery evidence. These are written once and retained with the parcel.
  releasedToName             String?
  releasedToIdNumber         String?
  releasedAt                 DateTime?
  deliveredToName            String?
  deliveredToIdNumber        String?
  deliveredAt                DateTime?
  deliveryProofType          String? // SIGNATURE | PHOTO | ID_CONFIRMATION
  deliveryProofReference     String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer          Customer           @relation(fields: [customerId], references: [id])
  createdBy         User               @relation("parcelsCreatedBy", fields: [createdById], references: [id])
  location          Location?          @relation(fields: [locationId], references: [id])
  events            TrackingEvent[]    @relation("parcelEvents")
  transfers         ParcelTransfer[]
  trackingIndex     TrackingIndex?
  serviceOrders     ServiceOrder[]
  container         Container?         @relation(fields: [containerId], references: [id], onDelete: Restrict)
  buyForMeRequests  BuyForMeRequest[]
  shipForMeRequests ShipForMeRequest[]

  @@unique([organizationId, trackingSequence])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId, createdAt])
}

// trackingIndex equivalent: unique public tracking ID lookup + QR payload
model TrackingIndex {
  trackingId String   @id
  parcelId   String   @unique
  createdAt  DateTime @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id])
}

// Goods the customer is sending, itemized under one shipment request.
// A shipment can hold many things (5–6 boxes, clothing, appliances...).
model ParcelItem {
  id                  String    @id @default(uuid())
  parcelId            String
  name                String // "Clothing box", "60-inch TV", "Spices"...
  details             String? // short free-form description for the intake team
  quantity            Int       @default(1)
  weightKg            Float? // optional per-item estimate
  position            Int       @default(0)
  type                String    @default("BOX") // BOX | SUITCASE | BARREL | TV | APPLIANCE | FURNITURE | PALLET | VEHICLE | DOCUMENTS | OTHER
  lengthCm            Float? // optional package dimensions, recorded together
  widthCm             Float?
  heightCm            Float?
  packageCode         String? // D2F…-P01-style sub-ID allocated when goods enter D2F custody
  warehouseReceivedAt DateTime?
  collectedAt         DateTime? // set for every observed package at a pickup collection
  notCollectedReason  String? // why a declared package was not on hand
  createdAt           DateTime  @default(now())

  parcel       Parcel        @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  parcelImages ParcelImage[]

  @@index([parcelId, position])
}

// Photos of the goods, attached by the customer. Stored as bytes so the
// shipped-evidence gallery survives hosting redeploys without object storage.
// An image attaches to the whole shipment or, via itemId, to one declared
// package; the association freezes once the shipment leaves intake editing.
model ParcelImage {
  id           String   @id @default(uuid())
  parcelId     String
  itemId       String? // optional: this photo documents one declared package
  fileName     String
  contentType  String // image/jpeg | image/png | image/webp
  sizeBytes    Int
  bytes        Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  parcel     Parcel      @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  item       ParcelItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([parcelId, createdAt])
}

// Timestamped, traceable event history
model TrackingEvent {
  id           String   @id @default(uuid())
  parcelId     String
  status       String
  note         String?
  originalNote String?
  internalNote String?
  templateId   String?
  facilityId   String?
  location     String?
  actorId      String?
  createdAt    DateTime @default(now())

  parcel Parcel @relation("parcelEvents", fields: [parcelId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([parcelId, createdAt])
}

// Physical facility-to-facility movement after international arrival. A parcel
// must be received at the named destination before it can be released there.
model ParcelTransfer {
  id             String   @id @default(uuid())
  parcelId       String
  fromLocationId String?
  toLocationId   String
  actorId        String?
  note           String?
  createdAt      DateTime @default(now())

  parcel       Parcel    @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  fromLocation Location? @relation("transferFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location  @relation("transferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  actor        User?     @relation("transferActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([parcelId, createdAt])
}

// Audit log for material actions (M1: registration + status updates)
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  detail    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// M2: a parcel belongs to at most one container. Loading closes at departure.
model Container {
  id             String           @id @default(uuid())
  organizationId String
  code           String
  originId       String
  destinationId  String
  method         String           @default("SEA")
  status         String           @default("LOADING")
  sealNumber     String?
  notes          String?
  manifest       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  origin         Location         @relation("containerOrigin", fields: [originId], references: [id], onDelete: Restrict)
  destination    Location         @relation("containerDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  parcels        Parcel[]
  events         ContainerEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, createdAt])
}

model ContainerEvent {
  id          String    @id @default(uuid())
  containerId String
  action      String
  detail      String?
  actorName   String
  createdAt   DateTime  @default(now())
  container   Container @relation(fields: [containerId], references: [id], onDelete: Restrict)

  @@index([containerId, createdAt])
}

// D2F Marketplace sellers. One profile per account; customers apply in the
// app, administrators approve and agree the commission rate BEFORE the first
// sale. Commission is snapshotted on every order from the agreed profile rate.
model SellerProfile {
  id                 String    @id @default(uuid())
  organizationId     String
  userId             String    @unique
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  displayName        String
  businessType       String    @default("INDIVIDUAL") // INDIVIDUAL | BUSINESS
  businessName       String?
  headline           String?
  bio                String?
  category           String
  phone              String
  email              String?
  country            String
  city               String?
  address            String?
  // Agreed before the first sale; basis points (1000 = 10.00%).
  commissionBps      Int       @default(1000)
  termsAcceptedAt    DateTime?
  termsAccepted      Boolean   @default(false)
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Shop branding: profile photo + cover banner, stored like product photos.
  profilePicture     Bytes?
  profilePictureName String?   @default("")
  banner             Bytes?
  bannerName         String?   @default("")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]
  orders       ServiceOrder[]
  verification SellerVerification?
  earnings     SellerEarnings?
  payouts      SellerPayout[]

  @@index([organizationId, status, createdAt])
}

// Seller identity/business verification documents submitted during onboarding.
model SellerVerification {
  id               String        @id @default(uuid())
  sellerId         String        @unique
  seller           SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  idDocumentType   String? // passport | national_id | business_license
  idDocumentName   String?
  idDocumentBytes  Bytes?
  businessDocName  String?
  businessDocBytes Bytes?
  selfieBytes      Bytes?
  status           String        @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// Global D2F commission / fee configuration (configurable, not hardcoded).
model CommissionSettings {
  id                       String   @id @default(uuid())
  // Platform commission on marketplace sales (basis points, 1000 = 10%).
  platformCommissionBps    Int      @default(1000)
  // Default fulfillment fee (basis points of order amount) when D2F fulfils.
  defaultFulfillmentFeeBps Int      @default(500)
  // Default delivery fee (basis points) for D2F delivery.
  defaultDeliveryFeeBps    Int      @default(300)
  updatedAt                DateTime @updatedAt
  updatedById              String?
}

// Seller earnings accumulator (commission + fulfillment + delivery fees tracked separately).
model SellerEarnings {
  id                        String        @id @default(uuid())
  sellerId                  String        @unique
  seller                    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // Gross merchandise value sold (before fees).
  grossMerchandiseMinor     Int           @default(0)
  // Commission earned by D2F from this seller.
  commissionEarnedMinor     Int           @default(0)
  // Fulfillment fees earned by D2F.
  fulfillmentFeeEarnedMinor Int           @default(0)
  // Delivery fees earned by D2F.
  deliveryFeeEarnedMinor    Int           @default(0)
  // Net payable to seller.
  netPayableMinor           Int           @default(0)
  // Amount already paid out.
  paidOutMinor              Int           @default(0)
  updatedAt                 DateTime      @updatedAt
}

// Payouts to sellers (admin-triggered).
model SellerPayout {
  id          String        @id @default(uuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amountMinor Int
  currency    String        @default("USD")
  status      String        @default("PENDING") // PENDING | PAID | CANCELLED
  paidAt      DateTime?
  reference   String? // bank transfer ref, etc.
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Administrative records for the selected Marketplace and Buy For Me modules.
// D2F catalog products have no seller; third-party listings belong to an
// approved SellerProfile. Stock stays null/uncounted until the Fulfillment
// phase, but the columns exist so warehouse counts can land without a
// destructive migration.
model Product {
  id              String         @id @default(uuid())
  organizationId  String
  title           String
  category        String
  description     String?
  priceMinor      Int
  currency        String         @default("USD")
  status          String         @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED | SUSPENDED
  isActive        Boolean        @default(false)
  sellerId        String?
  fulfillment     String         @default("D2F") // SELLER | D2F
  stockCount      Int? // null = stock not tracked yet (Fulfillment phase)
  locationCity    String?
  locationCountry String?
  featured        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seller          SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  orders          ServiceOrder[]
  images          ProductImage[]

  @@index([organizationId, createdAt])
  @@index([organizationId, isActive, category])
  @@index([organizationId, isActive, featured])
  @@index([sellerId])
}

// Product photos ride in the database as bytes (same policy as goods photos)
// so listings survive redeploys without external object storage.
model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  fileName    String
  contentType String
  sizeBytes   Int
  bytes       Bytes
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ServiceOrder {
  id                     String                          @id @default(uuid())
  organizationId         String
  kind                   String
  customerId             String
  productId              String?
  sellerId               String?
  parcelId               String?
  title                  String
  sourceUrl              String?
  quantity               Int                             @default(1)
  amountMinor            Int?
  currency               String                          @default("USD")
  status                 String                          @default("REQUESTED")
  notes                  String?
  source                 String                          @default("ADMIN") // ADMIN | APP
  // Commission snapshot taken from the agreed seller rate at order time.
  commissionBps          Int?
  commissionMinor        Int?
  // Fulfillment fee charged by D2F (when D2F fulfils).
  fulfillmentFeeBps      Int?
  fulfillmentFeeMinor    Int?
  // Delivery fee charged by D2F (when D2F delivers).
  deliveryFeeBps         Int?
  deliveryFeeMinor       Int?
  // Net amount payable to seller after all fees.
  sellerNetMinor         Int?
  // Delivery choice + recipient details captured at app checkout.
  deliveryPreference     String? // SELLER | D2F
  recipientName          String?
  recipientPhone         String?
  deliveryAddress        String?
  deliveryCity           String?
  deliveryStateProvince  String?
  deliveryCountry        String?
  deliveryPostalCode     String?
  // Buy For Me: buyer's target budget and the seller's carrier reference.
  budgetMinor            Int?
  trackingRef            String?
  productCostMinor       Int?
  shippingCostMinor      Int?
  paymentStatus          String                          @default("NOT_SUBMITTED")
  paymentTransactionId   String?
  deliveryService        String?
  shippingCarrier        String?
  shippingTrackingNumber String?
  shippingLabelUrl       String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer               Customer                        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product                Product?                        @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller                 SellerProfile?                  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  parcel                 Parcel?                         @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  paymentSubmissions     ServiceOrderPaymentSubmission[]
  updates                ServiceOrderUpdate[]

  @@index([organizationId, kind, createdAt])
  @@index([organizationId, sellerId, createdAt])
}

model ServiceOrderPaymentSubmission {
  id             String       @id @default(uuid())
  serviceOrderId String
  userId         String
  method         String
  transactionId  String
  fileName       String
  contentType    String
  bytes          Bytes
  status         String       @default("PENDING")
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId, createdAt])
}

model ServiceOrderUpdate {
  id                     String       @id @default(uuid())
  serviceOrderId         String
  actorId                String
  status                 String?
  message                String
  deliveryService        String?
  shippingCarrier        String?
  shippingTrackingNumber String?
  shippingLabelUrl       String?
  fileName               String?
  contentType            String?
  bytes                  Bytes?
  createdAt              DateTime     @default(now())
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId, createdAt])
}

// D2F Connect has its own commercial and custody workflow. Traveller access is
// projected by the API: never return customer identities, addresses or contacts.
model ConnectTrip {
  id                    String              @id @default(uuid())
  organizationId        String
  travellerId           String
  origin                String
  destination           String
  departureAt           DateTime
  flightNumber          String
  capacityKg            Float
  categories            String[]
  verificationReference String
  status                String              @default("PENDING_REVIEW")
  reviewNote            String?
  receivingLocationId   String?
  compensationMinor     Int                 @default(0)
  expensesMinor         Int                 @default(0)
  currency              String              @default("USD")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  traveller             User                @relation(fields: [travellerId], references: [id], onDelete: Restrict)
  receivingLocation     Location?           @relation(fields: [receivingLocationId], references: [id], onDelete: Restrict)
  requestedBookings     ConnectBooking[]    @relation("requestedTrip")
  assignments           ConnectAssignment[]

  @@index([organizationId, status, departureAt])
}

model ConnectRate {
  id             String       @id @default(uuid())
  organizationId String
  origin         String
  destination    String
  category       String
  unit           String // KG | ITEM | FLAT | MANUAL
  amountMinor    Int
  maxWeightKg    Float?
  currency       String       @default("USD")
  isActive       Boolean      @default(true)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, origin, destination, category])
}

model ConnectBooking {
  id                         String                     @id @default(uuid())
  organizationId             String
  parcelId                   String                     @unique
  category                   String
  quantity                   Int
  declaredValueMinor         Int
  preferredDate              DateTime
  requestedTripId            String?
  verifiedWeightKg           Float?
  contentsVerifiedAt         DateTime?
  contentsVerificationNote   String?
  internationalFeeMinor      Int?
  domesticCostMinor          Int?
  currency                   String                     @default("USD")
  paymentInstructions        String?
  pricingSnapshot            Json?
  quoteAcceptedAt            DateTime?
  handoverMode               String // DOMESTIC_SHIPPING | DROP_OFF | PICKUP
  senderCity                 String
  senderAddress              String?
  deliveryPreference         String                     @default("D2F_PICKUP")
  domesticCarrier            String?
  domesticTrackingNumber     String?
  domesticLabelUrl           String?
  domesticStatus             String                     @default("NOT_REQUIRED")
  receivingLocationId        String?
  originReceivedAt           DateTime?
  handoverCodeHash           String?
  handoverCodeExpiresAt      DateTime?
  handoverAttempts           Int                        @default(0)
  collectedAt                DateTime?
  destinationReceivedAt      DateTime?
  deliveredAt                DateTime?
  deliveryEvidence           String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parcel                     Parcel                     @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  requestedTrip              ConnectTrip?               @relation("requestedTrip", fields: [requestedTripId], references: [id], onDelete: Restrict)
  receivingLocation          Location?                  @relation(fields: [receivingLocationId], references: [id], onDelete: Restrict)
  assignments                ConnectAssignment[]
  payment                    ConnectPayment?
  declarations               ConnectDeclaration[]
  paymentSubmissions         ConnectPaymentSubmission[]
  reviewedDeclarationId      String?
  complianceReviewedById     String?
  paymentInstructionsVersion Int                        @default(0)

  @@index([organizationId, createdAt])
}

model ConnectAssignment {
  id           String                        @id @default(uuid())
  bookingId    String
  tripId       String
  status       String                        @default("PROPOSED")
  responseNote String?
  createdAt    DateTime                      @default(now())
  acceptedAt   DateTime?
  confirmedAt  DateTime?
  declarations ConnectTravellerDeclaration[]
  booking      ConnectBooking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  trip         ConnectTrip                   @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tripId, status])
  @@index([bookingId, status])
}

model ConnectPayment {
  id             String         @id @default(uuid())
  organizationId String
  bookingId      String         @unique
  reference      String
  amountMinor    Int
  currency       String         @default("USD")
  recordedById   String
  createdAt      DateTime       @default(now())
  booking        ConnectBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
}

// Append-only customer acknowledgments. Contents changes create a new revision.
model ConnectDeclaration {
  id             String         @id @default(uuid())
  bookingId      String
  customerId     String
  userId         String
  legalName      String
  contents       String
  contentsHash   String
  termsVersion   String
  acknowledgment String
  checks         Json
  guidance       Json
  audit          Json
  createdAt      DateTime       @default(now())
  booking        ConnectBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

// Submission is evidence awaiting admin verification; it never confirms payment.
model ConnectPaymentSubmission {
  id                   String         @id @default(uuid())
  bookingId            String
  userId               String
  method               String
  transactionId        String?
  instructionsVersion  Int
  instructionsSnapshot String
  fileName             String?
  contentType          String?
  bytes                Bytes?
  status               String         @default("PENDING")
  reviewNote           String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime       @default(now())
  booking              ConnectBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

model OperationalNoteTemplate {
  id              String   @id @default(uuid())
  organizationId  String
  status          String
  serviceType     String   @default("ALL")
  message         String
  customerMessage String
  isActive        Boolean  @default(true)
  position        Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([organizationId, status, isActive])
}

model ConnectTravellerDeclaration {
  id             String            @id @default(uuid())
  assignmentId   String
  userId         String
  legalName      String
  contentsHash   String
  termsVersion   String
  contents       String
  checks         Json
  acknowledgment String
  audit          Json
  createdAt      DateTime          @default(now())
  assignment     ConnectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([assignmentId, createdAt])
}

// Device-reported print audit. These records do not change physical custody.
model LabelPrintJob {
  id             String   @id @default(uuid())
  organizationId String
  parcelId       String
  actorId        String
  clientJobId    String
  printerName    String
  printerAddress String?
  labelHash      String
  pages          Int
  status         String
  message        String?
  source         String
  reason         String?
  deviceAt       DateTime
  createdAt      DateTime @default(now())

  @@unique([organizationId, actorId, clientJobId])
  @@index([organizationId, parcelId, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// BUY FOR ME — D2F purchases items on behalf of the customer
// ══════════════════════════════════════════════════════════════════════════════
model BuyForMeRequest {
  id             String       @id @default(uuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // What the customer wants
  title       String // Product description
  sourceUrl   String? // Product link (Amazon, eBay, etc.)
  sourceSite  String? // amazon, ebay, walmart, other
  quantity    Int     @default(1)
  currency    String  @default("USD")
  budgetMinor Int? // Customer's target budget (cents/XOF)
  notes       String?

  // D2F's quote (filled by admin)
  productCostMinor   Int? // Cost of the item itself
  taxMinor           Int? // Applicable taxes
  purchasingFeeMinor Int? // D2F purchasing service fee
  shippingFeeMinor   Int? // International shipping to customer
  otherChargesMinor  Int? // Insurance, handling, etc.
  totalQuoteMinor    Int? // Grand total customer must pay
  quoteValidUntil    DateTime? // Quote expiration
  quoteNotes         String? // Admin notes on the quote

  // Status workflow
  status        String @default("REQUESTED") // REQUESTED | QUOTED | ACCEPTED | PURCHASED | RECEIVED | SHIPPED | COMPLETED | CANCELLED | DECLINED
  paymentStatus String @default("UNPAID") // UNPAID | PARTIAL | PAID | REFUNDED

  // Purchase tracking (D2F fills after buying)
  purchaseDate    DateTime? // When D2F bought the item
  purchaseReceipt String? // Receipt URL/reference
  supplierOrderId String? // Supplier's order number

  // Receiver details
  recipientName    String?
  recipientPhone   String?
  recipientAddress String?
  recipientCity    String?
  recipientCountry String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime? // When customer accepted the quote
  paidAt      DateTime? // When payment was received
  shippedAt   DateTime? // When D2F shipped to customer
  completedAt DateTime? // When customer confirmed receipt

  // Relations
  parcel         Parcel?         @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  parcelId       String?
  payments       Payment[]
  returnRequests ReturnRequest[]

  @@index([customerId, status, createdAt])
  @@index([organizationId, status, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// SHIP FOR ME — Customer purchases themselves, D2F receives & ships
// ══════════════════════════════════════════════════════════════════════════════
model ShipForMeRequest {
  id             String       @id @default(uuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Customer's warehouse assignment
  warehouseAddressId  String? // Which D2F warehouse address
  customerWarehouseId String? // Unique customer ID at warehouse (e.g., D2F-12345)

  // What the customer bought (their own purchase)
  retailerName       String? // Amazon, Walmart, eBay, etc.
  retailerOrderId    String? // Customer's order number at retailer
  retailerTrackingId String? // Tracking from retailer to D2F warehouse
  itemDescription    String? // What was purchased
  declaredValueMinor Int? // Customer's declared value for customs
  declaredCurrency   String? @default("USD")

  // Package details (filled when D2F receives at warehouse)
  packageWeightKg  Float? // Actual weight received
  packageLengthCm  Float?
  packageWidthCm   Float?
  packageHeightCm  Float?
  packagePhotos    String? // JSON array of photo URLs/refs
  receivedAt       DateTime? // When D2F warehouse received it
  receivedBy       String? // Warehouse staff who received
  packageCondition String? // Good / Damaged / Opened / etc.
  receivingNotes   String?

  // Status workflow
  status            String    @default("DRAFT") // DRAFT | SUBMITTED | RECEIVED | QUOTED | ACCEPTED | PAID | SHIPPED | COMPLETED | CANCELLED | BLOCKED
  agreementAccepted Boolean   @default(false) // Customer accepted Ship For Me terms
  agreementVersion  String? // Which version of terms they accepted
  acceptedAt        DateTime? // When they accepted terms

  // Shipping quote (D2F fills after receiving package)
  shippingFeeMinor  Int? // Cost to ship from warehouse to customer
  insuranceFeeMinor Int? // Optional insurance
  handlingFeeMinor  Int? // Warehouse handling fee
  totalQuoteMinor   Int? // Grand total
  quoteValidUntil   DateTime? // Quote expiration
  quoteNotes        String?

  // Payment
  paymentStatus String    @default("UNPAID") // UNPAID | PARTIAL | PAID | REFUNDED
  paidAt        DateTime?

  // Shipping
  shippingMethod    String? // AIR | SEA | ROAD
  carrier           String? // DHL, FedEx, etc.
  carrierTrackingId String? // Tracking from D2F to customer
  shippedAt         DateTime?
  deliveredAt       DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime? // When customer submitted retailer details

  // Relations
  parcel         Parcel?         @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  parcelId       String?
  payments       Payment[]
  returnRequests ReturnRequest[]

  @@index([customerId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([customerWarehouseId])
}

// ══════════════════════════════════════════════════════════════════════════════
// WAREHOUSE ADDRESSES — D2F receiving addresses for Ship For Me
// ══════════════════════════════════════════════════════════════════════════════
model WarehouseAddress {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  label          String // e.g. "D2F US Warehouse - Delaware"
  addressLine1   String
  addressLine2   String?
  city           String
  stateProvince  String?
  postalCode     String
  country        String
  phone          String?
  email          String?
  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
}

// ══════════════════════════════════════════════════════════════════════════════
// CUSTOMER AGREEMENT — Terms acceptance with versioning
// ══════════════════════════════════════════════════════════════════════════════
model CustomerAgreement {
  id            String   @id @default(uuid())
  version       String   @unique // e.g. "ship-for-me-v1.0"
  title         String
  content       String // Full terms text
  serviceType   String // "SHIP_FOR_ME" | "BUY_FOR_ME" | "GENERAL"
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  acceptances CustomerAgreementAcceptance[]
}

// ══════════════════════════════════════════════════════════════════════════════
// CUSTOMER AGREEMENT ACCEPTANCE — Who accepted which version
// ══════════════════════════════════════════════════════════════════════════════
model CustomerAgreementAcceptance {
  id          String            @id @default(uuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agreementId String
  agreement   CustomerAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  version     String // Denormalized for quick lookup
  acceptedAt  DateTime          @default(now())
  acceptedVia String? // "APP" | "WEB" | "ADMIN"
  ipAddress   String?

  @@unique([customerId, agreementId])
  @@index([customerId, acceptedAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// PAYMENTS — Tracks all payments for both services
// ══════════════════════════════════════════════════════════════════════════════
model Payment {
  id String @id @default(uuid())

  // Polymorphic: which service this payment belongs to
  buyForMeRequestId  String?
  buyForMeRequest    BuyForMeRequest?  @relation(fields: [buyForMeRequestId], references: [id], onDelete: Cascade)
  shipForMeRequestId String?
  shipForMeRequest   ShipForMeRequest? @relation(fields: [shipForMeRequestId], references: [id], onDelete: Cascade)

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId String

  amountMinor       Int // Amount in minor currency unit
  currency          String  @default("USD")
  paymentMethod     String // CARD | BANK_TRANSFER | MOBILE_MONEY | MANUAL | WALLET
  paymentProvider   String? // stripe, paypal, flooz, t-money, etc.
  providerReference String? // External transaction ID

  status  String @default("PENDING") // PENDING | COMPLETED | FAILED | REFUNDED | CANCELLED
  purpose String // QUOTE_PAYMENT | DEPOSIT | FULL_PAYMENT | REFUND

  // Manual verification fields
  verificationNotes String?
  verifiedBy        String? // Admin who verified
  verifiedAt        DateTime?
  verificationImage String? // Photo of bank transfer receipt, etc.

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([customerId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([buyForMeRequestId])
  @@index([shipForMeRequestId])
}

// ══════════════════════════════════════════════════════════════════════════════
// PAYMENT METHODS CONFIG — Configurable by country and service
// ══════════════════════════════════════════════════════════════════════════════
model PaymentMethodConfig {
  id             String   @id @default(uuid())
  organizationId String
  serviceType    String // "BUY_FOR_ME" | "SHIP_FOR_ME" | "MARKETPLACE" | "ALL"
  countryCode    String // "US", "TG", "ALL"
  method         String // "CARD", "BANK_TRANSFER", "MOBILE_MONEY", "MANUAL"
  provider       String? // "stripe", "flooz", "t-money", etc.
  isActive       Boolean  @default(true)
  minAmountMinor Int? // Minimum amount for this method
  maxAmountMinor Int? // Maximum amount for this method
  feePercent     Int?     @default(0) // Additional fee in bps
  feeFixedMinor  Int?     @default(0) // Fixed fee in minor units
  config         String? // JSON for provider-specific config
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, serviceType, countryCode, isActive])
}

// ══════════════════════════════════════════════════════════════════════════════
// RETURN REQUESTS — Customer returns for both services
// ══════════════════════════════════════════════════════════════════════════════
model ReturnRequest {
  id String @id @default(uuid())

  buyForMeRequestId  String?
  buyForMeRequest    BuyForMeRequest?  @relation(fields: [buyForMeRequestId], references: [id], onDelete: Cascade)
  shipForMeRequestId String?
  shipForMeRequest   ShipForMeRequest? @relation(fields: [shipForMeRequestId], references: [id], onDelete: Cascade)

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId String

  reason               String // Damaged, Wrong item, Not as described, etc.
  description          String?
  requestedAmountMinor Int? // Refund amount customer wants

  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED
  adminDecision String? // Admin notes
  decidedAt     DateTime?
  decidedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status, createdAt])
  @@index([organizationId, status, createdAt])
}
