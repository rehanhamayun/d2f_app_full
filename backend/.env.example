# Local development only. Copy to .env and replace the placeholders.
# Create a separate local PostgreSQL database; do not use the hosted database.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://d2f:replace-with-local-db-password@127.0.0.1:5434/d2f_shipping?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional private bootstrap credentials. Required for production seeding.
DEMO_STAFF_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Optional recovery email and Google/Apple sign-in. See AUTH_SETUP.md.
RESEND_API_KEY=
AUTH_FROM_EMAIL=
AUTH_PUBLIC_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
