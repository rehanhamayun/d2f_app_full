# Copy me to ".env" (same folder) and CHANGE the secrets.
DB_PASSWORD=change-me-strong-db-pass
JWT_SECRET=change-me-long-random-string

# Optional account recovery. No email/SMS verification is required to register.
# Use a sender address on a verified Resend domain.
RESEND_API_KEY=
AUTH_FROM_EMAIL=

# Optional browser-based Google / Apple sign-in. Keep secrets on the server.
# Register these exact callbacks with the corresponding provider:
#   ${AUTH_PUBLIC_URL}/auth/social/google/callback
#   ${AUTH_PUBLIC_URL}/auth/social/apple/callback
AUTH_PUBLIC_URL=https://d2f-api-production.up.railway.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Apple P8 key, with newlines escaped as \n if your host requires one line.
APPLE_PRIVATE_KEY=
